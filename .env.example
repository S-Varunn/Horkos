# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# LLM Configuration (Configured for Hermes 3 via OpenRouter, Groq, or Ollama)
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama: http://localhost:11434/v1
# For Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Database Configuration
DATABASE_PATH=commitment_radar.db

# Timezone & Alert Settings
DEFAULT_TIMEZONE=UTC
ALERT_ADVANCE_MINUTES=30
CHECK_INTERVAL_SECONDS=30

# Google Calendar Integration
# Set GOOGLE_CALENDAR_ENABLED=true to enable agent scheduling to Google Calendar
GOOGLE_CALENDAR_ENABLED=true
# Option A: OAuth2 Desktop credentials (downloaded credentials.json from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Option B: Service account JSON (e.g. service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Target calendar (default "primary")
GOOGLE_CALENDAR_ID=primary
# Automatically schedule events when commitments are detected
AUTO_SCHEDULE_CALENDAR=true
# Default reminder popup lead times in minutes (comma-separated)
CALENDAR_REMINDER_MINUTES=30,10
